# .env.example
# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DB_USER=postgres
DB_PASSWORD=securepassword
DB_NAME=video_creator

# --- Backend ---
SECRET_KEY=change-me-in-production
OPENAI_API_KEY=

# Directories inside the backend container (backed by named volumes so files
# survive container restarts - see docker-compose.yml).
OUTPUT_DIR=/app/outputs
UPLOAD_DIR=/app/uploads

# faster-whisper model size: tiny | base | small | medium | large-v3
# Downloads automatically on first use.
WHISPER_MODEL=base

# --- Frontend ---
# 127.0.0.1, not localhost: avoids a Windows/WSL2 Docker Desktop quirk
# where localhost can resolve to a stale IPv6 listener after a container
# restart and hang requests forever.
VITE_API_URL=http://127.0.0.1:8000
